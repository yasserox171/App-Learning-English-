# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://lms:lms@localhost:5432/lms

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (comma-separated origins; empty = allow all in DEBUG)
CORS_ALLOWED_ORIGINS=

# Social auth (Phase 2 — stubs for now)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Video service (hosting decision deferred — see master prompt §7)
VIDEO_PLAYBACK_BASE_URL=http://localhost:8000/media/videos/
